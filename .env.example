# Hypostasia — Variables d'environnement

# --- Domaine et securite ---
DOMAIN=hypo.nasjo.fr
SECRET_KEY=CHANGEZ_MOI_EN_PROD
DEBUG=false

# --- UID/GID du container (doit matcher l'utilisateur hote pour les volumes) ---
# Trouver votre UID/GID : id -u && id -g
UID=1000
GID=1000

# --- Base de donnees PostgreSQL ---
POSTGRES_DB=hypostasia
POSTGRES_USER=hypostasia
POSTGRES_PASSWORD=CHANGEZ_MOI_EN_PROD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Nginx (dev.conf pour dev, default.conf pour prod) ---
NGINX_CONF=default.conf

# --- Redis / Celery / Django Channels ---
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- Cles API ---
# LES CLES NE SONT JAMAIS EN BASE. Aucun modele n'a de champ pour en
# porter une : ces variables sont la SEULE source. Un modele servi par
# une plateforme compatible OpenAI dit seulement, dans sa ligne, quelle
# variable lire (`variable_de_cle_api`).
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
# OpenRouter ne sert PAS l'extraction (LangExtract ne pilote que Google,
# OpenAI et Ollama) : cette cle sert a affecter un modele a un ROLE —
# juge de verification, redacteur d'article — par la commande
# `affecter_un_modele_a_un_role`.
OPENROUTER_API_KEY=

# --- Email ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@hypostasia.org
# SITE_URL=https://hypo.nasjo.fr
#
# SANS EMAIL_HOST*, LE BACKEND PAR DEFAUT EST LA CONSOLE : les mails
# s'impriment dans les journaux du conteneur et personne ne recoit
# rien, SANS la moindre erreur. Pour eprouver la configuration :
#   docker compose exec web python manage.py \
#       envoyer_le_recapitulatif_du_matin --adresse-de-test toi@exemple.fr
# (un essai n'enregistre aucun envoi : il ne consomme la journee de
#  personne)

# --- La nuit des wikis (heures en UTC, comme TIME_ZONE) ---
# La planification vit dans le code (`hypostasia/celery.py`), pas dans
# un crontab : ces deux variables ne font que deplacer l'heure.
# Apres modification : make restart S=celery_beat
# HEURE_PASSE_DE_NUIT=2      # la passe met a jour les wikis — FACTURE
# HEURE_RECAPITULATIF=6      # le mail, un par personne et par jour

# --- Sauvegarde borg (ecrit par `make backup`, NE RIEN REMPLIR ICI) ---
# `make backup` genere la cle SSH, cree le depot sur borgwarehouse,
# tire une passphrase et te la fait mettre au coffre. Laisser ces lignes
# commentees : les remplir a la main, c'est risquer de rendre des
# archives existantes illisibles.
#
# BORG_PREFIX=       prefixe des archives, et nom de la cle SSH du depot
# BORG_REPO=         adresse ssh:// du depot sur borgwarehouse
# BORG_PASSPHRASE=   passphrase du depot — A METTRE AU COFFRE, avec la
#                    cle exportee (borg key export) et l'adresse du
#                    depot. Sans elles, les archives sont un bloc
#                    chiffre definitivement illisible : c'est le seul
#                    maillon que la sauvegarde ne peut pas se
#                    sauvegarder elle-meme.
# AGE_MAX_HEURES=    age max de la derniere archive avant que
#                    `make backup-check` crie (25 pour du quotidien)
#
# Le jeton de creation de depot, lui, ne vit PAS ici : il est lu dans la
# variable d'environnement `borgwarehouse_ccc_api` (a defaut
# `BW_API_TOKEN`), le temps d'un unique appel, et n'est jamais stocke.
